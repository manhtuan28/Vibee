@{
    ViewData["Title"] = "Nạp tiền vào ví";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 text-center pt-4">
            <h4 class="fw-bold mb-1">Nạp tiền</h4>
            <p class="text-muted small">Chọn phương thức thanh toán</p>
        </div>
        <div class="card-body p-4">
            <form method="post" action="/Wallet/CreateDeposit" id="depositForm">
                <div class="mb-4">
                    <label class="form-label fw-bold text-muted small">SỐ TIỀN (VND)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 fw-bold">₫</span>

                        <input type="text" id="displayAmount" class="form-control bg-light border-0 fw-bold text-primary"
                               placeholder="50,000" required style="font-size: 1.5rem;" oninput="formatCurrency(this)">

                        <input type="hidden" name="amount" id="realAmount">
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <span class="badge bg-light text-dark cursor-pointer border" onclick="setAmount(50000)">50k</span>
                        <span class="badge bg-light text-dark cursor-pointer border" onclick="setAmount(100000)">100k</span>
                        <span class="badge bg-light text-dark cursor-pointer border" onclick="setAmount(200000)">200k</span>
                        <span class="badge bg-light text-dark cursor-pointer border" onclick="setAmount(500000)">500k</span>
                        <span class="badge bg-light text-dark cursor-pointer border" onclick="setAmount(1000000)">1tr</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-muted small mb-3">CỔNG THANH TOÁN</label>

                    <div class="d-grid gap-3">
                        <label class="btn btn-outline-light d-flex align-items-center justify-content-between p-3 border rounded-3 text-dark cursor-pointer">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="gateway" value="MOMO" class="form-check-input me-3 cursor-pointer" checked>
                                <img src="https://i.ibb.co/GvLyg5Pz/MOMO-Logo-App.png" width="32" class="rounded me-2">
                                <span class="fw-bold">Ví MoMo</span>
                            </div>
                            <span class="badge bg-danger">HOT</span>
                        </label>

                        <label class="btn btn-outline-light d-flex align-items-center justify-content-between p-3 border rounded-3 text-dark cursor-pointer">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="gateway" value="VNPAY" class="form-check-input me-3 cursor-pointer">
                                <img src="https://vinadesign.vn/uploads/images/2023/05/vnpay-logo-vinadesign-25-12-57-55.jpg" width="32" class="rounded me-2">
                                <span class="fw-bold">VNPAY QR / ATM</span>
                            </div>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm" onclick="return validateAmount()">
                    Xác nhận nạp
                </button>
                <a href="/Wallet" class="btn btn-link text-decoration-none w-100 mt-2 text-muted">Quay lại</a>
            </form>
        </div>
    </div>
</div>

<script>
    function formatCurrency(input) {
        let value = input.value.replace(/\D/g, "");

        document.getElementById('realAmount').value = value;

        if (value) {
            input.value = new Intl.NumberFormat('en-US').format(value);
        } else {
            input.value = "";
        }
    }

    function setAmount(val) {
        document.getElementById('realAmount').value = val;

        let display = document.getElementById('displayAmount');
        display.value = new Intl.NumberFormat('en-US').format(val);
    }

    function validateAmount() {
        let amount = document.getElementById('realAmount').value;
        if (!amount || amount < 10000) {
            alert("Số tiền nạp tối thiểu là 10,000 VND");
            return false;
        }
        return true;
    }
</script>