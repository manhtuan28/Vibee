@model Vibee.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Giới thiệu";
}
<partial name="_ProfileHeader" model="Model" />
<div class="container mt-3" style="max-width: 1050px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h4 class="fw-bold mb-4">Giới thiệu</h4>
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-muted fw-bold mb-3">Tổng quan</h6>
                <div class="mb-3"><i class="bi bi-briefcase-fill text-muted me-2"></i> Công việc: <strong>@(Model.User.Job ?? "--")</strong></div>
                <div class="mb-3"><i class="bi bi-house-door-fill text-muted me-2"></i> Sống tại: <strong>@(Model.User.LiveAt ?? "--")</strong></div>
                <div class="mb-3"><i class="bi bi-geo-alt-fill text-muted me-2"></i> Đến từ: <strong>@(Model.User.From ?? "--")</strong></div>
                @if (!string.IsNullOrEmpty(Model.User.Gender))
                {
                    <div class="d-flex align-items-center mb-2 text-muted">
                        @if (Model.User.Gender == "Nam")
                        {
                            <i class="bi bi-gender-male me-2 fs-5"></i>
                        }
                        else if (Model.User.Gender == "Nữ")
                        {
                            <i class="bi bi-gender-female me-2 fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-gender-ambiguous me-2 fs-5"></i>
                        }

                        <span>Giới tính: <strong class="text-dark">@Model.User.Gender</strong></span>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <h6 class="text-muted fw-bold mb-3">Liên hệ</h6>
                <div class="mb-3"><i class="bi bi-envelope-fill text-muted me-2"></i> Email: <strong>@Model.User.Email</strong></div>
                <div class="mb-3"><i class="bi bi-clock-fill text-muted me-2"></i> Tham gia: <strong>tháng @Model.User.JoinDate.ToString("MM/yyyy")</strong></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function uploadCover() {
            var file = document.getElementById('coverInput').files[0];
            var formData = new FormData();
            formData.append('file', file);

            var img = document.getElementById('coverImageDisplay');
            img.style.opacity = '0.5';

            $.ajax({
                url: '/Profile/UploadCover',
                type: 'POST',
                data: formData,
                processData: false, contentType: false,
                success: function(res) {
                    if (res.success) {
                        img.src = res.newUrl;
                        img.style.opacity = '1';
                        Swal.fire({ toast: true, position: 'bottom-start', icon: 'success', title: 'Đã cập nhật ảnh bìa', showConfirmButton: false, timer: 3000 });
                    } else {
                        alert(res.message);
                        img.style.opacity = '1';
                    }
                }
            });
        }
    </script>
}