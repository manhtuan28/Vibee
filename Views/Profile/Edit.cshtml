@model Vibee.Models.ApplicationUser
@{
    ViewData["Title"] = "Chỉnh sửa trang cá nhân";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3">
            <h4 class="fw-bold mb-0">Chỉnh sửa trang cá nhân</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="UpdateInfo" method="post">
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tên hiển thị</label>
                    <input type="text" name="FullName" class="form-control" value="@Model.FullName" required placeholder="Tên của bạn">
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-1">Tên người dùng (URL)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">vibee.com/Profile/</span>
                        <input type="text" name="UrlHandle" class="form-control" value="@Model.UrlHandle" placeholder="VD: b.manhtuan.282">
                    </div>
                    <div class="form-text text-muted" style="font-size: 0.85rem;">
                        Chỉ dùng chữ thường, số và dấu chấm. Đây sẽ là đường dẫn trang cá nhân của bạn.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-1">Tiểu sử</label>
                    <textarea name="Bio" class="form-control" rows="3" placeholder="Mô tả ngắn về bạn...">@Model.Bio</textarea>
                </div>

                <h5 class="fw-bold mt-4 mb-3 border-bottom pb-2">Thông tin chi tiết</h5>

                <div class="mb-3">
                    <label class="fw-bold mb-1"><i class="bi bi-gender-ambiguous me-1"></i> Giới tính</label>
                    <select name="Gender" class="form-select">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam" selected="@(Model.Gender == "Nam")">Nam</option>
                        <option value="Nữ" selected="@(Model.Gender == "Nữ")">Nữ</option>
                        <option value="Khác" selected="@(Model.Gender == "Khác")">Khác</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1"><i class="bi bi-briefcase-fill me-1"></i> Công việc</label>
                    <input type="text" name="Job" class="form-control" value="@Model.Job" placeholder="VD: Developer tại Google">
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-1"><i class="bi bi-house-door-fill me-1"></i> Sống tại</label>
                    <input type="text" name="LiveAt" class="form-control" value="@Model.LiveAt" placeholder="VD: Hà Nội">
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-1"><i class="bi bi-geo-alt-fill me-1"></i> Đến từ</label>
                    <input type="text" name="From" class="form-control" value="@Model.From" placeholder="VD: Nam Định">
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="/Profile/@(Model.UrlHandle ?? Model.Id)" class="btn btn-light fw-bold">Hủy</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>