@model Vibee.Models.ApplicationUser
@{
    ViewData["Title"] = "Chỉnh sửa trang cá nhân";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3">
            <h4 class="fw-bold mb-0">Chỉnh sửa trang cá nhân</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="UpdateInfo" method="post">
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tên hiển thị</label>
                    <input type="text" name="FullName" class="form-control" value="@Model.FullName" required>
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-1">Tiểu sử</label>
                    <textarea name="Bio" class="form-control" rows="3" placeholder="Mô tả ngắn về bạn...">@Model.Bio</textarea>
                    <div class="form-text text-end">Sẽ hiển thị ngay dưới tên của bạn.</div>
                </div>

                <hr class="my-4">
                <h5 class="fw-bold mb-3">Chi tiết</h5>

                <div class="mb-3">
                    <label class="mb-1"><i class="bi bi-briefcase me-2 text-muted"></i>Công việc</label>
                    <input type="text" name="Job" class="form-control" value="@Model.Job" placeholder="VD: Developer tại Vibee">
                </div>

                <div class="mb-3">
                    <label class="mb-1"><i class="bi bi-house-door me-2 text-muted"></i>Sống tại</label>
                    <input type="text" name="LiveAt" class="form-control" value="@Model.LiveAt" placeholder="VD: Hà Nội">
                </div>

                <div class="mb-3">
                    <label class="mb-1"><i class="bi bi-geo-alt me-2 text-muted"></i>Đến từ</label>
                    <input type="text" name="From" class="form-control" value="@Model.From" placeholder="VD: Nam Định">
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/Profile" class="btn btn-light fw-bold">Hủy</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>