@model Vibee.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = Model.User.FullName;
}

<link rel="stylesheet" href="~/css/home.css">
<link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />
<script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>

<style>
    .profile-body {
        max-width: 1050px;
        margin: 0 auto;
        padding: 16px 32px;
    }

    .intro-box {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        padding: 16px;
        position: sticky;
        top: 80px;
    }

    @@media (max-width: 991.98px) {
        .profile-body {
            padding: 16px 10px;
        }

        .intro-box {
            position: static;
            margin-bottom: 16px;
        }
    }
</style>

<partial name="_ProfileHeader" model="Model" />

<div class="profile-body">
    <div class="row">
        <div class="col-lg-5 col-12 mb-3">
            <div class="intro-box">
                <h5 class="fw-bold mb-3">Giới thiệu</h5>

                @if (!string.IsNullOrEmpty(Model.User.Bio))
                {
                    <div class="text-center mb-3 fst-italic">"@Model.User.Bio"</div>
                }

                @if (!string.IsNullOrEmpty(Model.User.Job))
                {
                    <div class="mb-2"><i class="bi bi-briefcase-fill text-muted me-2"></i>Công việc <strong>@Model.User.Job</strong></div>
                }

                @if (!string.IsNullOrEmpty(Model.User.LiveAt))
                {
                    <div class="mb-2"><i class="bi bi-house-door-fill text-muted me-2"></i>Sống tại <strong>@Model.User.LiveAt</strong></div>
                }

                @if (!string.IsNullOrEmpty(Model.User.From))
                {
                    <div class="mb-2"><i class="bi bi-geo-alt-fill text-muted me-2"></i>Quê quán <strong>@Model.User.From</strong></div>
                }

                @if (!string.IsNullOrEmpty(Model.User.Gender))
                {
                    <div class="mb-2">
                        @if (Model.User.Gender == "Nam")
                        {
                            <i class="bi bi-gender-male text-muted me-2"></i>
                        }
                        else if (Model.User.Gender == "Nữ")
                        {

                            <i class="bi bi-gender-female text-muted me-2"></i>
                        }
                        else
                        {

                            <i class="bi bi-gender-ambiguous text-muted me-2"></i>
                        }
                        Giới tính <strong>@Model.User.Gender</strong>
                    </div>
                }

                @if (Model.IsOwner)
                {
                    <a href="/Profile/Edit" class="btn btn-light bg-secondary-subtle w-100 fw-bold mt-2">Chỉnh sửa chi tiết</a>
                }
            </div>

            <div class="intro-box mt-3 d-none d-lg-block">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Ảnh</h5>
                    <a href="#" class="text-decoration-none">Xem tất cả</a>
                </div>
                <div class="row g-1 rounded overflow-hidden">
                    <div class="col-4"><div class="bg-light ratio ratio-1x1 border rounded"></div></div>
                    <div class="col-4"><div class="bg-light ratio ratio-1x1 border rounded"></div></div>
                    <div class="col-4"><div class="bg-light ratio ratio-1x1 border rounded"></div></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7 col-12">
            @if (Model.IsOwner)
            {
                <div class="fb-card p-3 mb-3">
                    <div class="d-flex align-items-center mb-2 mt-1">
                        <img src="@(Model.User.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle me-2 border" width="40" height="40" style="object-fit:cover">
                        <div class="bg-light rounded-pill px-3 py-2 flex-grow-1 text-muted post-input-trigger user-select-none" onclick="openPostModal()">
                            @Model.User.FullName ơi, bạn đang nghĩ gì thế?
                        </div>
                    </div>
                    <hr class="my-2 opacity-15">
                    <div class="d-flex justify-content-between">
                        <button class="btn-action" onclick="openPostModal()"><i class="bi bi-images text-success" style="font-size:1.5rem"></i> <span class="d-none d-sm-inline">Ảnh/Video</span></button>
                        <button class="btn-action" onclick="openPostModal('feeling')"><i class="bi bi-emoji-smile-fill text-warning" style="font-size:1.5rem"></i> <span class="d-none d-sm-inline">Cảm xúc</span></button>
                    </div>
                </div>
            }

            <div id="profile-feed">
                @foreach (var post in Model.Posts)
                {
                    <div class="fb-card" id="post-@post.Id">
                        <div class="p-3 d-flex align-items-start">
                            <a href="/Profile/@(post.User?.UrlHandle ?? post.UserId)" class="text-decoration-none">
                                <img src="@(post.User?.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle me-2 border" width="40" height="40" style="object-fit:cover">
                            </a>
                            <div class="flex-grow-1">
                                <div class="mb-0 fw-bold" style="font-size: 0.95rem;">
                                    <a href="/Profile/@(post.User?.UrlHandle ?? post.UserId)" class="text-decoration-none text-dark hover-underline">@post.User?.FullName</a>
                                    @if (post.SharedPost != null)
                                    {
                                        <span class="fw-normal text-secondary"> đã chia sẻ một bài viết</span>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(post.Emotion))
                                        {
                                            <span class="fw-normal text-dark"> đang @Html.Raw(post.Emotion)</span>
                                        }
                                        @if (!string.IsNullOrEmpty(post.LocationName))
                                        {
                                            <span class="fw-normal text-dark"> tại <strong>@post.LocationName</strong></span>
                                        }
                                    }
                                </div>
                                <small class="text-muted" style="font-size: 0.8rem;">
                                    @post.CreatedAt.ToString("dd/MM/yyyy HH:mm") •
                                    @if (post.PrivacyLevel == 0)
                                    {
                                        <i class="bi bi-globe-americas" title="Công khai"></i>
                                    }
                                    else if (post.PrivacyLevel == 1)
                                    {

                                        <i class="bi bi-people-fill" title="Bạn bè"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-lock-fill" title="Chỉ mình tôi"></i>
                                    }
                                </small>
                            </div>

                            @if (Model.IsOwner || post.UserId == Model.CurrentUser?.Id)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:36px; height:36px" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEditModal(@post.Id)"><i class="bi bi-pencil me-2"></i> Chỉnh sửa</a></li>
                                        <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deletePost(@post.Id)"><i class="bi bi-trash me-2"></i> Xóa</a></li>
                                    </ul>
                                </div>
                            }
                        </div>

                        <div class="px-3 pb-2 text-dark text-break" style="font-size:0.95rem">@Html.Raw(post.Content)</div>

                        @if (post.SharedPost != null)
                        {
                            var original = post.SharedPost;
                            <div class="mx-3 mb-3 border rounded-3 overflow-hidden">
                                <div class="p-2 bg-light d-flex align-items-center border-bottom bg-opacity-10">
                                    <a href="/Profile/@(original.User?.UrlHandle ?? original.UserId)">
                                        <img src="@(original.User?.AvatarUrl ?? "/images/default-avatar.png")" width="32" height="32" class="rounded-circle me-2 border object-fit-cover">
                                    </a>
                                    <div class="lh-1">
                                        <a href="/Profile/@(original.User?.UrlHandle ?? original.UserId)" class="fw-bold text-dark text-decoration-none hover-underline small">@original.User?.FullName</a>
                                        <div class="text-muted" style="font-size: 0.7rem;">@original.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                                <div class="p-2 small text-dark text-break">@Html.Raw(original.Content)</div>

                                @if (original.Medias != null && original.Medias.Any())
                                {
                                    var count = original.Medias.Count;
                                    var layoutClass = "layout-" + (count > 5 ? 5 : count);
                                    var displayMedias = original.Medias.Take(5).ToList();
                                    var mediaJson = System.Text.Json.JsonSerializer.Serialize(original.Medias.Select(m => new { type = m.Type.ToString(), url = m.Url }));
                                    <div class="fb-media-grid @layoutClass">
                                        @for (int i = 0; i < displayMedias.Count; i++)
                                        {
                                            var media = displayMedias[i];
                                            bool isLastItem = (count > 5 && i == 4);
                                            int remaining = count - 5;
                                            if (media.Type == Vibee.Models.MediaType.Video)
                                            {
                                                string dataSetup = "{ \"fluid\": false, \"fill\": true, \"controls\": true, \"preload\": \"metadata\" }";
                                                <div class="media-item" style="cursor: default;">
                                                    <div class="feed-video-container">
                                                        <video id="feed-vid-share-@original.Id-@i" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="metadata" data-setup='@dataSetup'>
                                                            <source src="@media.Url" type="video/mp4" />
                                                        </video>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="media-item" onclick='openMediaViewer(@Html.Raw(mediaJson), @i)'>
                                                    <img src="@media.Url" alt="Media">
                                                    @if (isLastItem)
                                                    {
                                                        <div class="more-overlay">+@remaining</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (post.Medias != null && post.Medias.Any())
                        {
                            var count = post.Medias.Count;
                            var layoutClass = "layout-" + (count > 5 ? 5 : count);
                            var displayMedias = post.Medias.Take(5).ToList();
                            var mediaJson = System.Text.Json.JsonSerializer.Serialize(post.Medias.Select(m => new { type = m.Type.ToString(), url = m.Url }));
                            <div class="fb-media-grid @layoutClass">
                                @for (int i = 0; i < displayMedias.Count; i++)
                                {
                                    var media = displayMedias[i];
                                    bool isLastItem = (count > 5 && i == 4);
                                    int remaining = count - 5;
                                    if (media.Type == Vibee.Models.MediaType.Video)
                                    {
                                        string dataSetup = "{ \"fluid\": false, \"fill\": true, \"controls\": true, \"preload\": \"metadata\" }";
                                        <div class="media-item" style="cursor: default;">
                                            <div class="feed-video-container">
                                                <video id="feed-vid-@post.Id-@i" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="metadata" data-setup='@dataSetup'>
                                                    <source src="@media.Url" type="video/mp4" />
                                                </video>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="media-item" onclick='openMediaViewer(@Html.Raw(mediaJson), @i)'>
                                            <img src="@media.Url" alt="Media">
                                            @if (isLastItem)
                                            {
                                                <div class="more-overlay">+@remaining</div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <div class="d-flex align-items-center justify-content-between px-3 py-2 text-muted small">
                            <span>@(post.Likes?.Count ?? 0) lượt thích</span>
                            <span>@(post.Comments?.Count ?? 0) bình luận</span>
                        </div>

                        <div class="post-actions">
                            <div class="reaction-wrapper">
                                <button class="btn-action w-100" id="btn-react-@post.Id" onclick="doReact(@post.Id, 'Like')"><i class="bi bi-hand-thumbs-up"></i> Thích</button>
                            </div>
                            <button class="btn-action" onclick="toggleComment(@post.Id)"><i class="bi bi-chat-text"></i> Bình luận</button>
                            <button class="btn-action" onclick="sharePost(@post.Id)"><i class="bi bi-share"></i> Chia sẻ</button>
                        </div>

                        <div id="comment-box-@post.Id" class="mt-2 d-none px-3 pb-3">
                            <div id="comment-list-@post.Id"></div>
                            <div class="d-flex gap-2 mt-2">
                                <img src="@(Model.CurrentUser?.AvatarUrl ?? "/images/default-avatar.png")" width="32" height="32" class="rounded-circle">
                                <input class="form-control rounded-pill" placeholder="Viết bình luận..." onkeydown="if(event.keyCode==13) sendComment(@post.Id)">
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Posts.Any())
                {
                    <div class="text-center py-5 text-muted">Chưa có bài viết nào để hiển thị.</div>
                }
            </div>
        </div>
    </div>
</div>

<partial name="_CreatePostModal" />
<partial name="_EditPostModal" />

<div id="media-viewer" onclick="closeMediaViewer()">
    <div class="mv-close" onclick="closeMediaViewer()"><i class="bi bi-x-lg"></i></div>
    <div class="mv-content">
        <div class="mv-btn mv-prev" id="mv-prev" onclick="prevMedia(event)"><i class="bi bi-chevron-left"></i></div>
        <div id="mv-media-container" onclick="event.stopPropagation()"></div>
        <div class="mv-btn mv-next" id="mv-next" onclick="nextMedia(event)"><i class="bi bi-chevron-right"></i></div>
    </div>
</div>

@section Scripts {
    <script>
        const currentUserAvatar = '@(Model.CurrentUser?.AvatarUrl ?? "/images/default-avatar.png")';
        var targetId = '@Model.User.Id';
    </script>
    <script src="~/js/home.js"></script>
    <script>
        $(document).ready(function() {
            setTimeout(initFeedVideos, 500);
        });
        function uploadAvatar() {
            var file = document.getElementById('avatarInput').files[0];
            var formData = new FormData(); formData.append('file', file);
            var img = document.getElementById('avatarImageDisplay'); img.style.opacity = '0.5';
            $.ajax({ url: '/Profile/UploadAvatar', type: 'POST', data: formData, processData: false, contentType: false,
                success: function(res) { if (res.success) { img.src = res.newUrl; img.style.opacity = '1'; Swal.fire({ toast: true, position: 'bottom-start', icon: 'success', title: 'Đã cập nhật ảnh đại diện', showConfirmButton: false, timer: 3000 }); } else { alert(res.message); img.style.opacity = '1'; } }
            });
        }
        function uploadCover() {
            var file = document.getElementById('coverInput').files[0];
            var formData = new FormData(); formData.append('file', file);
            var img = document.getElementById('coverImageDisplay'); img.style.opacity = '0.5';
            $.ajax({ url: '/Profile/UploadCover', type: 'POST', data: formData, processData: false, contentType: false,
                success: function(res) { if (res.success) { img.src = res.newUrl; img.style.opacity = '1'; Swal.fire({ toast: true, position: 'bottom-start', icon: 'success', title: 'Đã cập nhật ảnh bìa', showConfirmButton: false, timer: 3000 }); } else { alert(res.message); img.style.opacity = '1'; } }
            });
        }
        function handleFriendAction(action) {
            let url = '';
            if (action === 'Add') url = '/Friends/AddFriend'; else if (action === 'Cancel') url = '/Friends/CancelRequest';
            else if (action === 'Accept') url = '/Friends/AcceptRequest'; else if (action === 'Unfriend') url = '/Friends/Unfriend';
            Swal.showLoading();
            $.post(url, { targetId: targetId }, function(res) { Swal.close(); if (res.success) { location.reload(); } else { Swal.fire('Lỗi', res.message || 'Có lỗi xảy ra', 'error'); } });
        }
    </script>
}