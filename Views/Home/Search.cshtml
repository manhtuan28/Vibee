@model List<Vibee.Models.ApplicationUser>
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="container mt-3" style="max-width: 800px;">
    <h4 class="fw-bold mb-4">Kết quả tìm kiếm cho: "@ViewBag.Query"</h4>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="list-group list-group-flush rounded-4">
                @foreach (var user in Model)
                {
                    <div class="list-group-item p-3 d-flex align-items-center">
                        <a href="/Profile/@user.Id">
                            <img src="@(user.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle border" width="60" height="60" style="object-fit:cover">
                        </a>

                        <div class="ms-3 flex-grow-1">
                            <a href="/Profile/@user.Id" class="text-decoration-none text-dark">
                                <h6 class="fw-bold mb-0 fs-5">@user.FullName</h6>
                            </a>
                            <small class="text-muted">
                                @if (!string.IsNullOrEmpty(user.LiveAt))
                                {
                                    <span>Sống tại @user.LiveAt</span>
                                }
                                else
                                {

                                    <span>Thành viên Vibee</span>
                                }
                            </small>
                        </div>

                        <a href="/Profile/@user.Id" class="btn btn-light bg-secondary-subtle fw-bold">Xem trang cá nhân</a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-search fs-1"></i>
            <p class="mt-2">Không tìm thấy ai có tên này.</p>
        </div>
    }
</div>