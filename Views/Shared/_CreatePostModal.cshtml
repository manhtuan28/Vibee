@using Microsoft.AspNetCore.Identity
@using Vibee.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content shadow-lg rounded-4 border-0">

            <div class="modal-header border-bottom position-relative py-3 justify-content-center">
                <button type="button" class="btn btn-light rounded-circle position-absolute start-0 ms-3 p-0 d-flex align-items-center justify-content-center d-none" id="btnBackView" onclick="switchView('default')" style="width: 36px; height: 36px;">
                    <i class="bi bi-arrow-left fs-5"></i>
                </button>

                <h5 class="modal-title fw-bold fs-5 text-center" id="modalTitle">Tạo bài viết</h5>

                <button type="button" class="btn-close bg-light rounded-circle position-absolute end-0 me-3 p-2" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">

                <div id="view-default" class="modal-view active">
                    <form id="createPostForm" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="p-3 overflow-auto custom-scrollbar" style="max-height: 60vh;">
                            <div class="d-flex mb-3 align-items-center">
                                <img src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle border" width="40" height="40" style="object-fit:cover">
                                <div class="ms-2">
                                    <div class="fw-bold small lh-1">
                                        @currentUser?.FullName
                                        <span id="statusArea" class="fw-normal text-muted ms-1"></span>
                                    </div>
                                    <div class="dropdown mt-1">
                                        <button class="btn btn-light btn-sm rounded px-2 py-0 border d-inline-flex align-items-center fw-bold bg-secondary-subtle" type="button" data-bs-toggle="dropdown" style="font-size: 12px;">
                                            <i class="bi bi-globe-americas me-1" id="privacyIcon"></i> <span id="privacyText">Công khai</span> <i class="bi bi-caret-down-fill ms-1" style="font-size: 10px;"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow border-0 p-1" style="width: 300px;">
                                            <li><button class="dropdown-item px-2 py-2 rounded d-flex align-items-center" type="button" onclick="setPrivacy(0, 'Công khai', 'bi-globe-americas')"><div class="rounded-circle bg-light p-2 me-2"><i class="bi bi-globe-americas fs-5"></i></div><div><div class="fw-bold">Công khai</div><small class="text-muted">Bất kỳ ai</small></div></button></li>
                                            <li><button class="dropdown-item px-2 py-2 rounded d-flex align-items-center" type="button" onclick="setPrivacy(1, 'Bạn bè', 'bi-people-fill')"><div class="rounded-circle bg-light p-2 me-2"><i class="bi bi-people-fill fs-5"></i></div><div><div class="fw-bold">Bạn bè</div><small class="text-muted">Chỉ bạn bè</small></div></button></li>
                                            <li><button class="dropdown-item px-2 py-2 rounded d-flex align-items-center" type="button" onclick="setPrivacy(2, 'Chỉ mình tôi', 'bi-lock-fill')"><div class="rounded-circle bg-light p-2 me-2"><i class="bi bi-lock-fill fs-5"></i></div><div><div class="fw-bold">Chỉ mình tôi</div><small class="text-muted">Riêng tư</small></div></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <textarea name="content" id="modalPostContent" class="form-control border-0 fs-5 px-0 mb-3" rows="2" placeholder="@currentUser?.FullName ơi, bạn đang nghĩ gì thế?" style="resize: none; box-shadow: none;"></textarea>

                            <div id="mediaPreviewContainer" class="d-none border rounded p-1 position-relative mb-3">
                                <button type="button" class="btn-close position-absolute top-0 end-0 m-2 z-3 bg-white shadow-sm p-2 rounded-circle" onclick="clearAllMedia()" title="Gỡ tất cả"></button>
                                <div id="modalMediaPreview" class="row g-1" style="max-height: 350px; overflow-y: auto;"></div>
                            </div>

                            <div class="border rounded-3 p-3 d-flex align-items-center justify-content-between shadow-sm mt-3">
                                <span class="fw-bold small cursor-pointer" onclick="document.getElementById('modalFileInput').click()">Thêm vào bài viết</span>
                                <div class="d-flex gap-1">
                                    <input type="file" id="modalFileInput" multiple accept="image/*,video/*" hidden onchange="handleFilesSelect(this)">

                                    <div class="btn-icon-hover rounded-circle p-2 cursor-pointer text-success" onclick="document.getElementById('modalFileInput').click()" title="Ảnh/Video"><i class="bi bi-images fs-4"></i></div>
                                    <div class="btn-icon-hover rounded-circle p-2 cursor-pointer text-warning" onclick="switchView('feeling')" title="Cảm xúc"><i class="bi bi-emoji-smile-fill fs-4"></i></div>
                                    <div class="btn-icon-hover rounded-circle p-2 cursor-pointer text-danger" onclick="switchView('location')" title="Check-in"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="locationName" id="hiddenLocation">
                        <input type="hidden" name="emotion" id="hiddenEmotion">
                        <input type="hidden" name="privacyLevel" id="hiddenPrivacy" value="0">
                    </form>

                    <div class="p-3 pt-0">
                        <button type="button" onclick="submitPostModal()" class="btn btn-primary w-100 fw-bold rounded-3 py-2 disabled" id="btnSubmitPost">Đăng</button>
                    </div>
                </div>

                <div id="view-feeling" class="modal-view">
                    <div class="modal-body p-0 custom-scrollbar" style="height: 400px; overflow-y: auto;">
                        <div class="p-2">
                            <h6 class="text-muted ms-2 small fw-bold">Cảm xúc</h6>
                            <div class="row g-1">
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('🙂', 'đang cảm thấy hạnh phúc')"><span class="fs-4 me-2">🙂</span> Hạnh phúc</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😆', 'đang cảm thấy vui vẻ')"><span class="fs-4 me-2">😆</span> Vui vẻ</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😍', 'đang cảm thấy đáng yêu')"><span class="fs-4 me-2">😍</span> Đáng yêu</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😎', 'đang cảm thấy thật ngầu')"><span class="fs-4 me-2">😎</span> Thật ngầu</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('🤩', 'đang cảm thấy hào hứng')"><span class="fs-4 me-2">🤩</span> Hào hứng</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😴', 'đang cảm thấy mệt mỏi')"><span class="fs-4 me-2">😴</span> Mệt mỏi</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😭', 'đang cảm thấy buồn')"><span class="fs-4 me-2">😭</span> Buồn</div></div>
                                <div class="col-6"><div class="item-list-row p-2 rounded hover-bg cursor-pointer d-flex align-items-center" onclick="selectFeeling('😡', 'đang cảm thấy tức giận')"><span class="fs-4 me-2">😡</span> Tức giận</div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="view-location" class="modal-view">
                    <div class="p-3 border-bottom">
                        <div class="input-group bg-light rounded-pill">
                            <span class="input-group-text bg-transparent border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control bg-transparent border-0" placeholder="Tìm kiếm vị trí..." id="searchLocInput">
                        </div>
                    </div>
                    <div class="modal-body p-0 custom-scrollbar" style="height: 350px; overflow-y: auto;">
                        <div id="locationLoading" class="text-center py-4 d-none">
                            <div class="spinner-border text-primary"></div>
                        </div>
                        <div id="locationList">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .modal-view {
        display: none;
    }

        .modal-view.active {
            display: block;
            animation: fadeIn 0.2s;
        }
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .btn-icon-hover:hover {
        background-color: #f2f2f2;
    }

    .hover-bg:hover {
        background-color: #f0f2f5;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #ccc;
        border-radius: 4px;
    }
</style>