<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vibee Social</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vibee.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f0f2f5;
            padding-top: 70px;
        }

        .navbar-vibee {
            background-color: #ffffff;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
            height: 60px;
        }

        .search-vibee {
            background-color: #f0f2f5;
            border-radius: 50px;
            border: none;
            padding-left: 20px;
        }

        .nav-center-item {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 50px;
            width: 100px;
            border-radius: 10px;
            color: #65676b;
            text-decoration: none;
            transition: 0.2s;
        }

            .nav-center-item:hover {
                background-color: #f0f2f5;
                color: var(--bs-primary);
            }

            .nav-center-item.active {
                color: var(--bs-primary);
                border-bottom: 3px solid var(--bs-primary);
                border-radius: 0;
            }

            .nav-center-item i {
                font-size: 1.5rem;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-vibee fixed-top px-3">
            <div class="container-fluid">

                <div class="d-flex align-items-center" style="min-width: 250px;">
                    <a class="navbar-brand fw-bold fs-3 text-primary me-3" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-messenger"></i> Vibee
                    </a>
                    <form class="d-none d-lg-block">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 rounded-start-pill ps-3"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-light border-0 rounded-end-pill search-vibee" placeholder="Tìm kiếm trên Vibee..." style="width: 200px;">
                        </div>
                    </form>
                </div>

                <div class="collapse navbar-collapse justify-content-center" id="navbarCenter">
                    <ul class="navbar-nav mb-2 mb-lg-0 gap-2">
                        <li class="nav-item">
                            <a class="nav-center-item active" asp-controller="Home" asp-action="Index" title="Trang chủ">
                                <i class="bi bi-house-door-fill"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-center-item" href="#" title="Bạn bè">
                                <i class="bi bi-people"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-center-item" href="#" title="Video">
                                <i class="bi bi-play-btn"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-center-item text-success" href="#" title="Ví Vibee">
                                <i class="bi bi-wallet2"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="d-flex align-items-center justify-content-end" style="min-width: 200px;">
                    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCenter">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="d-none d-md-flex gap-2 me-3">
                        <a href="#" class="btn btn-light rounded-circle border-0 bg-secondary-subtle fw-bold fs-5" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </a>
                        <a href="#" class="btn btn-light rounded-circle border-0 bg-secondary-subtle fw-bold fs-5" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-chat-dots-fill"></i>
                        </a>
                        <a href="#" class="btn btn-light rounded-circle border-0 bg-secondary-subtle fw-bold fs-5" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-bell-fill"></i>
                        </a>
                    </div>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>