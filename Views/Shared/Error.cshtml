@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="card border-danger shadow-sm" style="max-width: 600px; width: 100%;">
        <div class="card-header bg-danger text-white fw-bold py-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Đã xảy ra sự cố
        </div>
        <div class="card-body p-4 text-center">
            <h4 class="card-title fw-bold mb-3 text-danger">Rất tiếc, yêu cầu không thể xử lý.</h4>
            <p class="card-text text-muted mb-4">
                Hệ thống đã ghi nhận lỗi này. Vui lòng thử lại sau ít phút.
            </p>

            @if (Model != null && !string.IsNullOrEmpty(Model.RequestId))
            {
                <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark small font-monospace text-start">
                    <strong>Request ID:</strong> @Model.RequestId
                </div>
            }
            else
            {
                <div class="small text-muted fst-italic">Không có mã lỗi chi tiết.</div>
            }
            @* ---------------------------------------- *@

            <div class="mt-4">
                <a href="/" class="btn btn-primary fw-bold px-4">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>