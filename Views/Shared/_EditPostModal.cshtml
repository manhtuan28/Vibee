@using Microsoft.AspNetCore.Identity
@using Vibee.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="modal fade" id="editPostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4 border-0">
            <div class="modal-header border-bottom-0 text-center position-relative pb-2">
                <h5 class="modal-title w-100 fw-bold fs-5">Chỉnh sửa bài viết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <hr class="my-0 opacity-25">

            <div class="modal-body">
                <form id="editPostForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editPostId">

                    <div class="d-flex mb-3">
                        <img src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle me-2 border" width="40" height="40" style="object-fit:cover">
                        <div>
                            <div class="fw-bold small">
                                @currentUser?.FullName
                                <span id="editStatusArea"></span>
                            </div>

                            <div class="dropdown mt-1">
                                <button class="btn btn-light btn-sm rounded px-2 py-0 border d-inline-flex align-items-center" type="button" data-bs-toggle="dropdown" style="font-size: 11px;">
                                    <i class="bi bi-globe-americas me-1" id="editPrivacyIcon"></i> <span id="editPrivacyText">Công khai</span> <i class="bi bi-caret-down-fill ms-1"></i>
                                </button>
                                <ul class="dropdown-menu shadow border-0" style="font-size: 0.9rem;">
                                    <li><button class="dropdown-item px-3 py-2" type="button" onclick="setEditPrivacy(0, 'Công khai', 'bi-globe-americas')"><div class="fw-bold"><i class="bi bi-globe-americas me-2"></i> Công khai</div></button></li>
                                    <li><button class="dropdown-item px-3 py-2" type="button" onclick="setEditPrivacy(1, 'Bạn bè', 'bi-people-fill')"><div class="fw-bold"><i class="bi bi-people-fill me-2"></i> Bạn bè</div></button></li>
                                    <li><button class="dropdown-item px-3 py-2" type="button" onclick="setEditPrivacy(2, 'Chỉ mình tôi', 'bi-lock-fill')"><div class="fw-bold"><i class="bi bi-lock-fill me-2"></i> Chỉ mình tôi</div></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <textarea name="content" id="editContent" class="form-control border-0 fs-5 px-0" rows="3" style="resize: none; box-shadow: none;"></textarea>

                    <div id="editMediaContainer" class="border rounded p-1 bg-light mt-2">
                        <div id="oldMediaPreview" class="row g-2"></div>
                        <div id="newMediaPreview" class="row g-2 mt-2"></div>
                    </div>

                    <div class="add-to-post mt-3">
                        <span class="fw-bold small ps-2">Thêm vào bài viết</span>
                        <div class="add-to-post-icons d-flex gap-1">
                            <input type="file" id="editFileInput" multiple accept="image/*,video/*" hidden onchange="handleEditFiles(this)">

                            <div class="btn-icon text-success" onclick="document.getElementById('editFileInput').click()" title="Thêm ảnh/video"><i class="bi bi-images fs-5"></i></div>
                            <div class="btn-icon text-danger" onclick="clearEditStatus()" title="Gỡ địa điểm/cảm xúc"><i class="bi bi-x-circle fs-5"></i></div>
                        </div>
                    </div>

                    <input type="hidden" name="locationName" id="editHiddenLocation">
                    <input type="hidden" name="emotion" id="editHiddenEmotion">
                    <input type="hidden" name="privacyLevel" id="editHiddenPrivacy">
                    <input type="hidden" name="removedMediaIds" id="editRemovedMediaIds">
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" onclick="submitEditPost()" class="btn btn-primary w-100 fw-bold rounded-3 py-2" id="btnSaveEdit">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>