<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vibee Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --admin-sidebar-bg: #1e1e2d;
            --admin-sidebar-hover: #2b2b40;
            --admin-active: #3699ff;
            --admin-bg: #f5f8fa;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--admin-bg);
            margin: 0;
            overflow-x: hidden;
        }

        .wrapper {
            display: flex;
            width: 100%;
        }

        .sidebar {
            width: 265px;
            background-color: var(--admin-sidebar-bg);
            min-height: 100vh;
            color: #a2a3b7;
            position: fixed;
            transition: all 0.3s;
            z-index: 1000;
        }

        .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 25px;
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .sidebar-brand span {
                color: var(--admin-active);
            }

        .sidebar-menu {
            padding: 20px 0;
        }

        .menu-header {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
            color: #5d5f77;
            padding: 15px 25px 10px;
            letter-spacing: 0.5px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            padding: 12px 25px;
            color: #a2a3b7;
            text-decoration: none;
            transition: 0.2s;
            border-left: 3px solid transparent;
        }

            .menu-link:hover {
                color: white;
                background-color: var(--admin-sidebar-hover);
            }

            .menu-link.active {
                color: white;
                background-color: var(--admin-sidebar-hover);
                border-left-color: var(--admin-active);
            }

            .menu-link i {
                font-size: 1.2rem;
                width: 30px;
                color: #494b74;
                transition: 0.2s;
            }

            .menu-link.active i, .menu-link:hover i {
                color: var(--admin-active);
            }

        .main-panel {
            flex: 1;
            margin-left: 265px;
            display: flex;
            flex-direction: column;
        }

        .top-navbar {
            height: 70px;
            background-color: white;
            box-shadow: 0 0 20px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .content-wrapper {
            padding: 30px;
        }

        .btn-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            color: #7e8299;
            transition: 0.2s;
        }

            .btn-icon:hover {
                background-color: #f3f6f9;
                color: var(--admin-active);
            }
    </style>
</head>
<body>

    <div class="wrapper">
        <nav class="sidebar">
            <div class="sidebar-brand">
                Vibee<span>Admin</span>
            </div>

            <div class="sidebar-menu">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span class="ms-2">Tổng quan</span>
                </a>

                <div class="menu-header">Quản trị hệ thống</div>

                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span class="ms-2">Thành viên</span>
                </a>

                <a asp-area="Admin" asp-controller="Roles" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span class="ms-2">Phân quyền (Roles)</span>
                </a>

                <div class="menu-header">Tài chính (Fintech)</div>

                <a asp-area="Admin" asp-controller="Wallets" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Wallets" ? "active" : "")">
                    <i class="bi bi-wallet2"></i>
                    <span class="ms-2">Quản lý Ví</span>
                </a>

                <a asp-area="Admin" asp-controller="Transactions" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <i class="bi bi-clock-history"></i>
                    <span class="ms-2">Lịch sử giao dịch</span>
                </a>

                <div class="menu-header">Mạng xã hội</div>

                <a asp-area="Admin" asp-controller="Posts" asp-action="Index"
                   class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Posts" ? "active" : "")">
                    <i class="bi bi-postcard-fill"></i>
                    <span class="ms-2">Bài viết & Nội dung</span>
                </a>
            </div>

            <div style="position: absolute; bottom: 20px; width: 100%; padding: 0 25px;">
                <a href="/" class="btn btn-dark w-100 fw-bold border border-secondary" style="background: #2b2b40;">
                    <i class="bi bi-arrow-left-circle me-2"></i> Về trang chủ
                </a>
            </div>
        </nav>

        <div class="main-panel">
            <header class="top-navbar">
                <div class="d-flex align-items-center">
                    <span class="text-muted me-3"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-0 bg-transparent" placeholder="Tìm kiếm nhanh..." style="width: 250px;">
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="#" class="btn-icon" title="Thông báo">
                        <i class="bi bi-bell"></i>
                    </a>
                    <a href="#" class="btn-icon" title="Cài đặt">
                        <i class="bi bi-gear"></i>
                    </a>

                    <div class="border-start mx-2 h-50"></div>

                    <div class="d-flex align-items-center ms-2">
                        <div class="text-end me-3 d-none d-md-block">
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">Quản trị viên</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Super Admin</div>
                        </div>
                        <img src="~/images/default-avatar.png" class="rounded-circle border" width="40" height="40" alt="Admin">
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>