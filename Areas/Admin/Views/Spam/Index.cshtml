@model IEnumerable<Vibee.Models.IpBlock>
@{
    ViewData["Title"] = "Quản lý Chống Spam";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-shield-lock-fill me-2"></i>Hệ thống Chống Spam</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Cấu hình Luật</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateSettings" method="post">
                        <h6 class="text-primary fw-bold"><i class="bi bi-person-plus me-1"></i>Đăng ký</h6>
                        <div class="mb-3">
                            <label class="small text-muted">Số lần tối đa (trong 60p)</label>
                            <input type="number" name="regLimit" class="form-control" value="@ViewBag.RegLimit">
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted">Thời gian khóa (phút)</label>
                            <input type="number" name="regTime" class="form-control" value="@ViewBag.RegBlockTime">
                        </div>

                        <hr>

                        <h6 class="text-success fw-bold"><i class="bi bi-pencil-square me-1"></i>Đăng bài</h6>
                        <div class="mb-3">
                            <label class="small text-muted">Số bài tối đa (trong 5p)</label>
                            <input type="number" name="postLimit" class="form-control" value="@ViewBag.PostLimit">
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted">Thời gian khóa (phút)</label>
                            <input type="number" name="postTime" class="form-control" value="@ViewBag.PostBlockTime">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Lưu cấu hình</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Danh sách IP đang bị khóa</h5>
                    <span class="badge bg-danger">@Model.Count() IP</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">IP Address</th>
                                    <th>Loại</th>
                                    <th>Mở khóa lúc</th>
                                    <th>Lý do</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có IP nào bị chặn.</td></tr>
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold font-monospace">@item.IpAddress</td>
                                        <td>
                                            @if (item.Type == "Register")
                                            {
                                                <span class="badge bg-primary">Đăng ký</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-success">Đăng bài</span>
                                            }
                                        </td>
                                        <td class="text-danger fw-bold">@item.UnlockTime.ToString("HH:mm dd/MM")</td>
                                        <td class="small text-muted">@item.Reason</td>
                                        <td>
                                            <form asp-action="Unlock" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button class="btn btn-sm btn-outline-success" title="Mở khóa ngay">
                                                    <i class="bi bi-unlock-fill"></i> Mở
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>