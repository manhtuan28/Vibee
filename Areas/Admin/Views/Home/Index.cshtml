@model Vibee.Areas.Admin.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
        overflow: hidden;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #2af598 0%, #009efd 100%);
        color: white;
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
        color: white;
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
        color: white;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e9ecef;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
    }

    .table-modern thead th {
        border-bottom: 1px solid #f0f0f0;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        color: #8898aa;
        font-weight: 600;
        padding: 1rem;
    }

    .table-modern tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f8f9fa;
    }

    .progress-thin {
        height: 6px;
        border-radius: 10px;
        background-color: #edf2f7;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-5 fade-in">
    <div>
        <h3 class="fw-bold text-dark mb-1">Dashboard Overview</h3>
        <p class="text-muted mb-0">Chào mừng trở lại! Đây là tình hình hệ thống ngày @DateTime.Now.ToString("dd/MM/yyyy").</p>
    </div>
    <div>
        <button class="btn btn-light shadow-sm text-primary fw-bold me-2"><i class="bi bi-download me-2"></i>Báo cáo</button>
        <button class="btn btn-primary shadow fw-bold"><i class="bi bi-plus-lg me-2"></i>Tác vụ mới</button>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">Tổng tài sản ví</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalSystemMoney.ToString("N0") <span class="fs-6 text-muted">VND</span></h3>
                    <div class="mt-2 text-success small"><i class="bi bi-arrow-up-short"></i> Hệ thống ổn định</div>
                </div>
                <div class="stat-icon bg-gradient-success shadow">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">Tổng thành viên</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalUsers.ToString("N0")</h3>
                    <div class="mt-2 text-primary small"><i class="bi bi-people"></i> Cộng đồng lớn</div>
                </div>
                <div class="stat-icon bg-gradient-primary shadow">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100 p-4" style="border-left: 4px solid #fda085;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">Chờ xử lý</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.PendingTransactions</h3>
                    <div class="mt-2 text-warning small fw-bold">
                        @if (Model.PendingTransactions > 0)
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Cần duyệt ngay</span>
                        }
                        else
                        {

                            <span class="text-success"><i class="bi bi-check-circle"></i> Đã xử lý hết</span>
                        }
                    </div>
                </div>
                <div class="stat-icon bg-gradient-warning shadow">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">Nội dung chia sẻ</div>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalPosts.ToString("N0")</h3>
                    <div class="mt-2 text-info small"><i class="bi bi-activity"></i> Tương tác tốt</div>
                </div>
                <div class="stat-icon bg-gradient-info shadow">
                    <i class="bi bi-newspaper"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card h-100">
            <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Thành viên mới gia nhập</h6>
                    <small class="text-muted">Danh sách 5 thành viên đăng ký gần nhất</small>
                </div>
                <a href="/Admin/Users" class="btn btn-sm btn-outline-primary rounded-pill px-3">Quản lý User</a>
            </div>
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Thành viên</th>
                            <th>Email Liên hệ</th>
                            <th>Ngày tham gia</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.NewestUsers)
                        {
                            var initial = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "U";
                            var colorClass = new[] { "primary", "success", "danger", "warning", "info" }[new Random().Next(0, 5)];

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-@colorClass bg-opacity-10 text-@colorClass me-3">
                                            @initial
                                        </div>
                                        <span class="fw-bold text-dark">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td class="small fw-medium text-dark">@user.JoinDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <a href="#" class="btn btn-icon btn-sm btn-light text-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card mb-4">
            <div class="card-header bg-white py-3 px-4 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-cpu me-2 text-danger"></i>Health Monitor</h6>
            </div>
            <div class="card-body px-4 pb-4 pt-0">
                <div class="d-flex align-items-center mb-4 mt-2">
                    <div class="flex-grow-1">
                        <small class="text-uppercase text-muted fw-bold" style="font-size: 10px;">Operating System</small>
                        <div class="fw-bold text-dark">@Model.SystemStats.OsDescription</div>
                    </div>
                    <div class="badge bg-light text-dark border">Server</div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-bold text-secondary">RAM Usage (App)</span>
                        <span class="small fw-bold text-primary">@Model.SystemStats.MemoryDisplay</span>
                    </div>
                    <div class="progress progress-thin">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 25%"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-bold text-secondary">Disk Space (C:)</span>
                        <span class="small fw-bold text-warning">@Model.SystemStats.DiskUsagePercent%</span>
                    </div>
                    <div class="progress progress-thin">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @Model.SystemStats.DiskUsagePercent%"></div>
                    </div>
                </div>

                <div class="bg-light rounded p-3 mt-4 text-center">
                    <small class="text-muted d-block mb-1">System Uptime</small>
                    <div class="fw-bold text-success font-monospace fs-5">@Model.SystemStats.UptimeDisplay</div>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header bg-white py-3 px-4 border-0">
                <h6 class="fw-bold mb-0">Truy cập nhanh</h6>
            </div>
            <div class="list-group list-group-flush rounded-bottom">
                <a href="/Admin/Roles/Index" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Phân quyền (Roles)</div>
                        <div class="small text-muted">Cấu hình quyền truy cập</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>

                <a href="/Admin/Transactions/Index" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0">
                    <div class="stat-icon bg-success bg-opacity-10 text-success me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                        <i class="bi bi-bank"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Quản lý Giao dịch</div>
                        <div class="small text-muted">Duyệt nạp/rút tiền</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>
            </div>
        </div>
    </div>
</div>