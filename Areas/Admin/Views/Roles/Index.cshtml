@model IEnumerable<Vibee.Areas.Admin.Controllers.RoleViewModel>
@{
    ViewData["Title"] = "Quản lý Phân quyền";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-primary m-0"><i class="bi bi-shield-lock-fill me-2"></i> Nhóm quyền & Chức năng</h5>
        <button class="btn btn-primary" onclick="openRoleModal()">
            <i class="bi bi-plus-lg me-1"></i> Thêm mới
        </button>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Tên nhóm quyền</th>
                    <th>Số lượng chức năng</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr id="row_@role.Id">
                        <td class="ps-4">
                            <span class="fw-bold text-dark fs-6">@role.Name</span>
                            @if (role.Name == "Admin")
                            {
                                <span class="badge bg-danger ms-2">System</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@role.PermissionCount quyền truy cập</span>
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light text-primary me-1" onclick="openRoleModal('@role.Id')" title="Sửa quyền">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </button>

                            @if (role.Name != "Admin" && role.Name != "User")
                            {
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteRole('@role.Id')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Cấu hình phân quyền</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="roleId" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Tên nhóm quyền</label>
                    <input type="text" id="roleName" class="form-control form-control-lg" placeholder="Ví dụ: Manager, Content Writer...">
                </div>

                <label class="form-label fw-bold mb-3">Chọn chức năng được phép truy cập:</label>
                <div class="row g-3" id="permissionList">
                    <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveRole()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var roleModal = new bootstrap.Modal(document.getElementById('roleModal'));

        function openRoleModal(id = '') {
            $('#roleId').val(id);
            $('#modalTitle').text(id ? 'Cập nhật quyền' : 'Tạo quyền mới');
            $('#permissionList').html('<div class="text-center w-100"><div class="spinner-border text-primary"></div></div>');

            roleModal.show();

            $.get('/Admin/Roles/GetRole', { id: id }, function(res) {
                if(res.success) {
                    $('#roleName').val(res.roleName);

                    let html = '';
                    res.allPermissions.forEach(p => {
                        let parts = p.split('.');
                        let group = parts[1];
                        let action = parts[2];
                        let isChecked = res.selectedPermissions.includes(p) ? 'checked' : '';

                        html += `
                            <div class="col-md-6">
                                <div class="form-check p-3 border rounded bg-light">
                                    <input class="form-check-input permission-item" type="checkbox" value="${p}" id="perm_${p}" ${isChecked}>
                                    <label class="form-check-label fw-bold cursor-pointer" for="perm_${p}">
                                        <span class="text-primary">${group}</span> <span class="text-muted mx-1">|</span> ${action}
                                    </label>
                                </div>
                            </div>
                        `;
                    });
                    $('#permissionList').html(html);
                }
            });
        }

        function saveRole() {
            let id = $('#roleId').val();
            let name = $('#roleName').val();
            let perms = [];

            $('.permission-item:checked').each(function() {
                perms.push($(this).val());
            });

            $.post('/Admin/Roles/SaveRole', { id: id, roleName: name, permissions: perms }, function(res) {
                if(res.success) {
                    roleModal.hide();
                    Swal.fire('Thành công', res.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function deleteRole(id) {
            Swal.fire({
                title: 'Xóa quyền này?',
                text: "Các user thuộc quyền này sẽ bị mất quyền truy cập!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Xóa luôn'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Admin/Roles/Delete', { id: id }, function(res) {
                        if(res.success) {
                            $(`#row_${id}`).fadeOut();
                            Swal.fire('Đã xóa!', '', 'success');
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            })
        }
    </script>
}