@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Mã khôi phục";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập bằng mã khôi phục | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .vibee-logo {
            color: #1877f2;
            font-size: 40px;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 20px;
            text-decoration: none;
        }

        .recovery-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 500px;
            max-width: 90%;
            overflow: hidden;
            padding: 30px;
            text-align: center;
        }

        .icon-wrapper {
            width: 70px;
            height: 70px;
            background-color: #fff4e5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 35px;
                color: #f57c00;
            }

        .card-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .card-subtitle {
            font-size: 15px;
            color: #65676b;
            margin-bottom: 25px;
            line-height: 1.5;
            text-align: left;
            background-color: #f0f2f5;
            padding: 15px;
            border-radius: 6px;
        }

        .form-control {
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #ccd0d5;
            font-size: 16px;
            margin-bottom: 5px;
            font-family: monospace;
        }

            .form-control:focus {
                border-color: #1877f2;
                box-shadow: 0 0 0 2px #e7f3ff;
                outline: none;
            }

        .btn-verify {
            background-color: #1877f2;
            color: white;
            font-weight: 700;
            padding: 10px 0;
            width: 100%;
            border-radius: 6px;
            border: none;
            font-size: 17px;
            transition: 0.2s;
            margin-top: 15px;
        }

            .btn-verify:hover {
                background-color: #166fe5;
                color: white;
            }

        .back-link {
            margin-top: 20px;
            display: block;
            color: #65676b;
            text-decoration: none;
            font-size: 14px;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <a href="/" class="vibee-logo">vibee</a>

    <div class="recovery-card">
        <div class="icon-wrapper">
            <i class="bi bi-life-preserver"></i>
        </div>

        <h3 class="card-title">Sử dụng mã khôi phục</h3>

        <div class="card-subtitle">
            <i class="bi bi-info-circle-fill me-1"></i>
            Bạn đang yêu cầu đăng nhập bằng mã khôi phục. Việc đăng nhập này sẽ không được ghi nhớ cho đến khi bạn cung cấp mã xác thực từ ứng dụng hoặc tắt tính năng 2FA và đăng nhập lại.
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Nhập mã khôi phục" />
                <label asp-for="Input.RecoveryCode" class="text-secondary">Nhập mã khôi phục (VD: XXXXX-XXXXX)</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-verify">Đăng nhập</button>
        </form>

        <a href="javascript:history.back()" class="back-link">Quay lại trang trước</a>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>