@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Kiểm tra email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kiểm tra email | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        body {
            background-color: #f0f2f5;
            font-family: SFProDisplay-Regular, Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .fb-header {
            background-color: #ffffff;
            height: 60px;
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }

        .header-content {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-logo {
            color: #1877f2;
            font-size: 30px;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: -1px;
            line-height: 1;
        }

            .header-logo:hover {
                color: #1877f2;
            }

        .btn-header-login {
            background-color: #e4e6eb;
            color: #050505;
            font-weight: 600;
            font-size: 15px;
            padding: 8px 16px;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-header-login:hover {
                background-color: #d8dadf;
                color: #050505;
            }

        .content-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-grow: 1;
            padding-top: 60px;
        }

        .confirmation-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 500px;
            max-width: 90%;
            overflow: hidden;
            text-align: center;
            padding: 40px 30px;
        }

        .icon-wrapper {
            width: 80px;
            height: 80px;
            background-color: #e7f3ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 40px;
                color: #1877f2;
            }

        .card-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .card-text {
            font-size: 17px;
            color: #65676b;
            line-height: 1.5;
            margin-bottom: 30px;
        }

        .btn-primary-fb {
            background-color: #1877f2;
            color: white;
            font-weight: 600;
            padding: 0 30px;
            height: 40px;
            line-height: 40px;
            border-radius: 6px;
            border: none;
            font-size: 15px;
            transition: 0.2s;
            display: inline-block;
            text-decoration: none;
        }

            .btn-primary-fb:hover {
                background-color: #166fe5;
                color: white;
            }

        .small-note {
            margin-top: 20px;
            font-size: 13px;
            color: #8a8d91;
        }
    </style>
</head>
<body>

    <div class="fb-header">
        <div class="header-content">
            <a href="/Identity/Account/Login" class="header-logo">vibee</a>
            <a href="/Identity/Account/Login" class="btn-header-login">Đăng nhập</a>
        </div>
    </div>

    <div class="content-wrapper">
        <div class="confirmation-card">
            <div class="icon-wrapper">
                <i class="bi bi-envelope-check-fill"></i>
            </div>

            <h3 class="card-title">Kiểm tra email của bạn</h3>

            <p class="card-text">
                Chúng tôi đã gửi một liên kết đặt lại mật khẩu đến email của bạn.
                <br>
                Vui lòng kiểm tra hộp thư đến (và cả thư mục Spam/Rác).
            </p>

            <a href="/Identity/Account/Login" class="btn-primary-fb">Quay lại đăng nhập</a>

            <div class="small-note">
                <i class="bi bi-shield-check"></i> Không nhận được email? Hãy thử kiểm tra lại email đã nhập hoặc thử lại sau ít phút.
            </div>
        </div>
    </div>

</body>
</html>