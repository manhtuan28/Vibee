@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kích hoạt tài khoản | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .fb-header {
            background-color: #ffffff;
            height: 60px;
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }

        .header-content {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-logo {
            color: #1877f2;
            font-size: 30px;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: -1px;
            line-height: 1;
        }

            .header-logo:hover {
                color: #1877f2;
            }

        .btn-header-login {
            background-color: #e4e6eb;
            color: #050505;
            font-weight: 600;
            font-size: 15px;
            padding: 8px 16px;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-header-login:hover {
                background-color: #d8dadf;
                color: #050505;
            }

        .content-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-grow: 1;
            padding-top: 60px;
        }

        .confirmation-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 500px;
            overflow: hidden;
            text-align: center;
        }

        .card-body {
            padding: 40px 30px;
        }

        .icon-wrapper {
            width: 80px;
            height: 80px;
            background-color: #e7f3ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 40px;
                color: #1877f2;
            }

        .card-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .card-text {
            font-size: 17px;
            color: #606770;
            line-height: 1.5;
            margin-bottom: 30px;
        }

        .dev-mode-box {
            background-color: #e9f7ef;
            border: 1px dashed #28a745;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .dev-mode-text {
            font-size: 14px;
            color: #155724;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .btn-confirm-link {
            background-color: #42b72a;
            color: white;
            font-weight: 700;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            display: inline-block;
            transition: 0.2s;
        }

            .btn-confirm-link:hover {
                background-color: #36a420;
                color: white;
            }

        .btn-primary-fb {
            background-color: #1877f2;
            color: white;
            font-weight: 600;
            padding: 0 30px;
            height: 40px;
            line-height: 40px;
            border-radius: 6px;
            border: none;
            font-size: 15px;
            transition: 0.2s;
            display: inline-block;
            text-decoration: none;
        }

            .btn-primary-fb:hover {
                background-color: #166fe5;
                color: white;
            }
    </style>
</head>
<body>

    <div class="fb-header">
        <div class="header-content">
            <a href="/Identity/Account/Login" class="header-logo">vibee</a>
            <a href="/Identity/Account/Login" class="btn-header-login">Đăng nhập</a>
        </div>
    </div>

    <div class="content-wrapper">
        <div class="confirmation-card">
            <div class="card-body">
                <div class="icon-wrapper">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <h3 class="card-title">Kích hoạt tài khoản</h3>

                @if (@Model.DisplayConfirmAccountLink)
                {
                    <div class="dev-mode-box">
                        <p class="dev-mode-text">
                            <i class="bi bi-code-slash me-1"></i> DEV MODE: Hệ thống chưa cấu hình gửi Email thật.
                        </p>
                        <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn-confirm-link">
                            Bấm vào đây để kích hoạt ngay
                        </a>
                    </div>
                    <p class="small text-muted">Trong môi trường thực tế (Production), người dùng sẽ nhận được email chứa liên kết này.</p>
                }
                else
                {
                    <p class="card-text">
                        Tài khoản của bạn đã được tạo thành công!
                        <br>
                        Vui lòng kiểm tra email <strong>@Model.Email</strong> để kích hoạt tài khoản trước khi đăng nhập.
                    </p>
                    <a href="/Identity/Account/Login" class="btn-primary-fb">Quay lại đăng nhập</a>
                }
            </div>
        </div>
    </div>

</body>
</html>