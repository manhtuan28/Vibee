@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .vibee-logo {
            color: #1877f2;
            font-size: 40px;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 20px;
            text-decoration: none;
        }

        .reset-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 450px;
            max-width: 90%;
            overflow: hidden;
            padding: 30px;
            text-align: center;
        }

        .icon-wrapper {
            width: 70px;
            height: 70px;
            background-color: #e7f3ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 35px;
                color: #1877f2;
            }

        .card-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .card-subtitle {
            font-size: 15px;
            color: #65676b;
            margin-bottom: 25px;
        }

        .form-control {
            padding: 12px 16px;
            border-radius: 6px;
            border: 1px solid #ccd0d5;
            font-size: 16px;
            margin-bottom: 5px;
        }

            .form-control:focus {
                border-color: #1877f2;
                box-shadow: 0 0 0 2px #e7f3ff;
                outline: none;
            }

        .btn-reset {
            background-color: #1877f2;
            color: white;
            font-weight: 700;
            padding: 10px 0;
            width: 100%;
            border-radius: 6px;
            border: none;
            font-size: 17px;
            transition: 0.2s;
            margin-top: 15px;
        }

            .btn-reset:hover {
                background-color: #166fe5;
                color: white;
            }
    </style>
</head>
<body>

    <a href="/" class="vibee-logo">vibee</a>

    <div class="reset-card">
        <div class="icon-wrapper">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h3 class="card-title">Tạo mật khẩu mới</h3>
        <p class="card-subtitle">
            Vui lòng nhập email xác nhận và mật khẩu mới của bạn.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-start" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="Email" />
                <label asp-for="Input.Email" class="text-secondary">Email của bạn</label>
                <span asp-validation-for="Input.Email" class="text-danger small text-start d-block"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Mật khẩu mới" />
                <label asp-for="Input.Password" class="text-secondary">Mật khẩu mới</label>
                <span asp-validation-for="Input.Password" class="text-danger small text-start d-block"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                <label asp-for="Input.ConfirmPassword" class="text-secondary">Nhập lại mật khẩu</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small text-start d-block"></span>
            </div>

            <button type="submit" class="btn-reset">Lưu mật khẩu</button>
        </form>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>