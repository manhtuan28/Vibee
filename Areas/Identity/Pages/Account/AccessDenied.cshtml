@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Không tìm thấy trang";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang này không khả dụng | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            text-align: center;
        }

        .vibee-logo {
            color: #1877f2;
            font-size: 40px;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 40px;
            text-decoration: none;
            display: inline-block;
        }

        .error-icon {
            font-size: 80px;
            color: #b0b3b8;
            margin-bottom: 20px;
        }

        .error-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .error-text {
            font-size: 17px;
            color: #65676b;
            margin-bottom: 30px;
            max-width: 500px;
            line-height: 1.5;
        }

        .btn-home {
            background-color: #1877f2;
            color: white;
            font-weight: 600;
            padding: 10px 30px;
            border-radius: 6px;
            border: none;
            font-size: 15px;
            transition: 0.2s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-home:hover {
                background-color: #166fe5;
                color: white;
            }

        .help-link {
            margin-top: 20px;
            font-size: 14px;
            display: block;
        }

            .help-link a {
                color: #1877f2;
                text-decoration: none;
            }

                .help-link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>

    <a href="/" class="vibee-logo">vibee</a>

    <div>
        <i class="bi bi-file-earmark-break error-icon"></i>

        <h3 class="error-title">Trang này không khả dụng</h3>

        <p class="error-text">
            Liên kết bạn truy cập có thể bị hỏng, hoặc trang này có thể đã bị gỡ hay bạn không có quyền xem nội dung này.
        </p>

        <a href="/" class="btn-home">Quay về Bảng tin</a>

        <div class="help-link">
            <a href="javascript:history.back()">Quay lại trang trước</a>
        </div>
    </div>

</body>
</html>