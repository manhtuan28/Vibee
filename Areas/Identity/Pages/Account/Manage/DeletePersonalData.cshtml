@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Xóa tài khoản";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-danger shadow-sm border-danger" role="alert">
            <h4 class="alert-heading fw-bold">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Cảnh báo quan trọng!
            </h4>
            <p class="mb-0">
                Hành động này sẽ <strong>xóa vĩnh viễn</strong> tài khoản Vibee và toàn bộ dữ liệu liên quan (bao gồm số dư Ví, lịch sử giao dịch, bài đăng...).
                <br>
                <strong>Dữ liệu này không thể khôi phục lại được.</strong>
            </p>
        </div>

        <div class="card border-danger border-opacity-25 shadow-sm mt-4">
            <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold border-danger border-opacity-25">
                Xác nhận xóa tài khoản
            </div>
            <div class="card-body p-4">
                <form id="delete-user" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                    @if (Model.RequirePassword)
                    {
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold">Nhập mật khẩu của bạn</label>
                            <input asp-for="Input.Password" class="form-control border-danger" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu xác nhận..." />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                    }

                    <button class="btn btn-danger fw-bold w-100 mt-2" type="submit" onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản không? Hành động này không thể hoàn tác!');">
                        <i class="bi bi-trash3-fill me-2"></i> Xóa dữ liệu và đóng tài khoản
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}