@page
@model EmailModel
@{
    ViewData["Title"] = "Quản lý Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-9">
        <h4 class="fw-bold mb-4">@ViewData["Title"]</h4>

        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3 small" role="alert"></div>

            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <label class="form-label fw-bold text-uppercase small text-muted">Email hiện tại</label>
                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="input-group">
                            <input asp-for="Email" class="form-control text-success fw-bold bg-white" disabled />
                            <span class="input-group-text bg-success text-white fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i> Đã xác thực
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="input-group">
                            <input asp-for="Email" class="form-control text-dark fw-bold bg-white" disabled />
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-warning fw-bold">
                                <i class="bi bi-send me-1"></i> Gửi lại xác thực
                            </button>
                        </div>
                        <div class="form-text text-danger small mt-1">
                            <i class="bi bi-exclamation-triangle"></i> Email chưa xác thực. Bạn có thể bị hạn chế tính năng.
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-pencil-square me-2 text-primary"></i> Thay đổi Email
                </div>
                <div class="card-body">
                    <div class="alert alert-info small border-0 bg-info bg-opacity-10 text-info-emphasis">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Lưu ý: Sau khi đổi, bạn cần xác thực lại email mới để tiếp tục sử dụng.
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Nhập email mới..." />
                        <label asp-for="Input.NewEmail" class="text-secondary">Địa chỉ Email mới</label>
                        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                    </div>

                    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-arrow-repeat me-2"></i> Cập nhật Email
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}