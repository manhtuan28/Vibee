@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info-emphasis shadow-sm">
            <div class="d-flex">
                <i class="bi bi-info-circle-fill me-3 fs-4"></i>
                <div>
                    <strong>Bạn chưa có mật khẩu cục bộ</strong>
                    <p class="mb-0 small mt-1">
                        Hiện tại bạn đang đăng nhập thông qua tài khoản liên kết (Google/Facebook).
                        Hãy thiết lập mật khẩu riêng cho Vibee để có thể đăng nhập trực tiếp bằng Email trong trường hợp bạn bị mất quyền truy cập vào tài khoản xã hội.
                    </p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Mật khẩu mới" />
                        <label asp-for="Input.NewPassword" class="text-secondary">Mật khẩu mới</label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Xác nhận" />
                        <label asp-for="Input.ConfirmPassword" class="text-secondary">Nhập lại mật khẩu</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary fw-bold py-2 px-4">
                        <i class="bi bi-save me-2"></i> Lưu mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4 mt-4 mt-md-0">
        <div class="card bg-light border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-check text-success me-2"></i> Gợi ý bảo mật
                </h6>
                <ul class="list-unstyled small text-muted mb-0 d-grid gap-2">
                    <li><i class="bi bi-check2 text-primary me-1"></i> Tối thiểu 6 ký tự.</li>
                    <li><i class="bi bi-check2 text-primary me-1"></i> Nên có chữ hoa & thường.</li>
                    <li><i class="bi bi-check2 text-primary me-1"></i> Nên có ít nhất 1 số.</li>
                    <li><i class="bi bi-check2 text-primary me-1"></i> Thêm ký tự đặc biệt (!@@#).</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}