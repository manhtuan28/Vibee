@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Tạo mã khôi phục mới";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row justify-content-center">
    <div class="col-md-9">
        <h4 class="fw-bold mb-4">@ViewData["Title"]</h4>

        <div class="alert alert-warning shadow-sm border-warning" role="alert">
            <h4 class="alert-heading fw-bold mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Lưu ý quan trọng
            </h4>
            <p>
                <strong>Đặt các mã này ở nơi an toàn.</strong>
            </p>
            <p>
                Nếu bạn mất thiết bị (điện thoại) và không có mã khôi phục, bạn sẽ mất quyền truy cập vào tài khoản Vibee của mình vĩnh viễn.
            </p>
            <hr>
            <p class="mb-0 small">
                Việc tạo mã mới này không làm thay đổi khóa dùng trong ứng dụng xác thực (Authenticator App). Nếu bạn muốn thay đổi khóa (do đổi điện thoại), hãy dùng tính năng <a asp-page="./ResetAuthenticator" class="fw-bold text-dark text-decoration-underline">Đặt lại ứng dụng xác thực</a>.
            </p>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <span class="d-inline-block p-3 rounded-circle bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-repeat fs-1"></i>
                    </span>
                </div>

                <h5 class="card-title fw-bold">Tạo bộ mã mới?</h5>
                <p class="card-text text-muted mb-4">
                    Hành động này sẽ <strong>vô hiệu hóa</strong> tất cả các mã khôi phục cũ mà bạn từng lưu. Bạn chỉ có thể sử dụng bộ mã mới sau khi bấm nút dưới đây.
                </p>

                <form method="post">
                    <button class="btn btn-danger px-4 fw-bold py-2" type="submit">
                        <i class="bi bi-file-earmark-lock2 me-2"></i> Tạo bộ mã mới
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>