@page
@model IndexModel
@using Vibee.Models
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Thông tin công khai";
    ViewData["ActivePage"] = ManageNavPages.Index;

    var user = await UserManager.GetUserAsync(User);
    var avatarUrl = user?.AvatarUrl ?? "/images/default-avatar.png";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <h4 class="card-title fw-bold mb-4 border-bottom pb-3">@ViewData["Title"]</h4>
    <form id="profile-form" method="post" enctype="multipart/form-data" class="d-flex flex-wrap w-100">

        <div class="col-md-8 pe-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-bold text-muted small text-uppercase">Tên đăng nhập / Email</label>
                <input asp-for="Username" class="form-control bg-light" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label fw-bold">Họ và tên</label>
                <input asp-for="Input.FullName" class="form-control" placeholder="Tên hiển thị trên Vibee" />
                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label fw-bold">Số điện thoại</label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Bio" class="form-label fw-bold">Giới thiệu (Bio)</label>
                <textarea asp-for="Input.Bio" class="form-control" rows="4" placeholder="Viết đôi dòng về bản thân bạn..."></textarea>
                <span asp-validation-for="Input.Bio" class="text-danger small"></span>
            </div>

            <button id="update-profile-button" type="submit" class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-check-circle me-2"></i> Lưu thay đổi
            </button>
        </div>

        <div class="col-md-4 text-center mt-4 mt-md-0">
            <div class="card border-0 bg-light p-3">
                <h6 class="text-muted mb-3">Ảnh đại diện</h6>

                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img id="avatarPreview" src="@avatarUrl" alt="Avatar" class="rounded-circle border border-3 border-white shadow-sm" style="width: 150px; height: 150px; object-fit: cover;">

                    <div class="position-absolute bottom-0 end-0" style="cursor: pointer;" onclick="document.getElementById('avatarInput').click();">
                        <span class="btn btn-secondary btn-sm rounded-circle border border-2 border-white" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </div>
                </div>

                <input type="file" asp-for="Input.AvatarFile" class="d-none" id="avatarInput" accept="image/*" onchange="previewImage(this)">

                <p class="small text-muted mt-2">
                    Ảnh đại diện giúp mọi người nhận ra bạn dễ dàng hơn.
                </p>

                <button type="button" class="btn btn-outline-primary btn-sm w-100" onclick="document.getElementById('avatarInput').click();">
                    Tải ảnh mới lên
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}