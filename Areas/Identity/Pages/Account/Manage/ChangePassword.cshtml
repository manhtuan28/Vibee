@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7 pe-md-4">
        <h4 class="card-title fw-bold mb-4 border-bottom pb-3">@ViewData["Title"]</h4>
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Input.OldPassword" class="form-label fw-bold">Mật khẩu hiện tại</label>
                    <a asp-page="../ForgotPassword" class="text-decoration-none small fw-bold text-primary">Quên mật khẩu?</a>
                </div>
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu hiện tại..." />
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-bold">Mật khẩu mới</label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới..." />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Nhập lại mật khẩu mới</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Xác nhận lại mật khẩu..." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                <i class="bi bi-check-lg me-2"></i> Lưu mật khẩu
            </button>
        </form>
    </div>

    <div class="col-md-5 mt-4 mt-md-0">
        <div class="card bg-light border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-check text-success me-2"></i>
                    Mật khẩu mạnh là gì?
                </h6>
                <ul class="list-unstyled small text-muted mb-0 d-grid gap-2">
                    <li class="d-flex align-items-start">
                        <i class="bi bi-dot fs-4 lh-1 text-primary me-1"></i>
                        <span>Dài ít nhất 6 ký tự.</span>
                    </li>
                    <li class="d-flex align-items-start">
                        <i class="bi bi-dot fs-4 lh-1 text-primary me-1"></i>
                        <span>Nên bao gồm chữ hoa, chữ thường và số.</span>
                    </li>
                    <li class="d-flex align-items-start">
                        <i class="bi bi-dot fs-4 lh-1 text-primary me-1"></i>
                        <span>Thêm các ký tự đặc biệt (!@@#$%) để tăng độ khó.</span>
                    </li>
                    <li class="d-flex align-items-start">
                        <i class="bi bi-dot fs-4 lh-1 text-primary me-1"></i>
                        <span>Không dùng mật khẩu giống với các trang web khác.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}