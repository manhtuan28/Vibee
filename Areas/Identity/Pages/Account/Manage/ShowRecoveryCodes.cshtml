@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Mã khôi phục 2FA";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card border-danger shadow-sm">
    <div class="card-header bg-danger text-white fw-bold">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> Lưu trữ mã khôi phục an toàn
    </div>
    <div class="card-body p-4">
        <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark">
            <p class="fw-bold mb-1">Hãy sao chép và lưu các mã này ở nơi an toàn ngay lập tức.</p>
            <p class="mb-0 small">
                Nếu bạn bị mất điện thoại hoặc không thể sử dụng ứng dụng xác thực, các mã này là <strong>cách duy nhất</strong> để bạn đăng nhập lại vào tài khoản Vibee.
            </p>
        </div>

        <div class="bg-light p-4 rounded border mb-3 position-relative">
            <div class="row font-monospace fs-5 text-center" id="recovery-codes-list">
                @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
                {
                    <div class="col-md-6 mb-2">@Model.RecoveryCodes[row]</div>
                    <div class="col-md-6 mb-2">@Model.RecoveryCodes[row + 1]</div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary fw-bold" onclick="copyCodes()">
                <i class="bi bi-clipboard-check me-2"></i> Sao chép tất cả
            </button>
            <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary fw-bold">Đã lưu, tiếp tục</a>
        </div>
        <div id="copy-success" class="text-success small fw-bold mt-2" style="display:none;">
            <i class="bi bi-check-lg"></i> Đã sao chép vào bộ nhớ tạm!
        </div>
    </div>
</div>

<script>
    function copyCodes() {
        var codes = document.querySelectorAll('#recovery-codes-list div');
        var text = "";
        codes.forEach(c => text += c.innerText.trim() + "\n");

        navigator.clipboard.writeText(text).then(function() {
            var msg = document.getElementById('copy-success');
            msg.style.display = 'block';
            setTimeout(function() { msg.style.display = 'none'; }, 3000);
        });
    }
</script>