@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Liên kết tài khoản";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-9">
        <h4 class="fw-bold mb-4">@ViewData["Title"]</h4>

        @if (Model.CurrentLogins?.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    Các tài khoản đang liên kết
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var login in Model.CurrentLogins)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                            <div class="d-flex align-items-center">
                                <span class="fs-5 me-3">
                                    @if (login.ProviderDisplayName.ToLower().Contains("google"))
                                    {
                                        <i class="bi bi-google text-danger"></i>
                                    }
                                    else if (login.ProviderDisplayName.ToLower().Contains("facebook"))
                                    {

                                        <i class="bi bi-facebook text-primary"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-person-badge-fill text-secondary"></i>
                                    }
                                </span>
                                <span class="fw-bold text-dark">@login.ProviderDisplayName</span>
                            </div>

                            @if (Model.ShowRemoveButton)
                            {
                                <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold" title="Gỡ bỏ liên kết @login.ProviderDisplayName">
                                        <i class="bi bi-trash3-fill me-1"></i> Gỡ bỏ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Mặc định</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.OtherLogins?.Count > 0)
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    Thêm liên kết khác
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Chọn dịch vụ bạn muốn liên kết để đăng nhập nhanh hơn:</p>
                    <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="d-flex gap-2 flex-wrap">
                        @foreach (var provider in Model.OtherLogins)
                        {
                            <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-outline-primary fw-bold" name="provider" value="@provider.Name" title="Đăng nhập bằng @provider.DisplayName">
                                @if (provider.DisplayName.ToLower().Contains("google"))
                                {
                                    <i class="bi bi-google me-2"></i>
                                }
                                else if (provider.DisplayName.ToLower().Contains("facebook"))
                                {

                                    <i class="bi bi-facebook me-2"></i>
                                }
                                + Liên kết @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>
</div>