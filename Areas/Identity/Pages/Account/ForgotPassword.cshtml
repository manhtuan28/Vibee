@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .fb-header {
            background-color: #ffffff;
            height: 60px;
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }

        .header-content {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-logo {
            color: #1877f2;
            font-size: 30px;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: -1px;
            line-height: 1;
        }

            .header-logo:hover {
                color: #1877f2;
            }

        .btn-header-login {
            background-color: #e4e6eb;
            color: #050505;
            font-weight: 600;
            font-size: 15px;
            padding: 8px 16px;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-header-login:hover {
                background-color: #d8dadf;
                color: #050505;
            }

        .content-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-grow: 1;
            padding-top: 60px;
        }

        .find-account-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 500px;
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid #dadde1;
            background: white;
        }

            .card-header h2 {
                font-size: 20px;
                font-weight: 700;
                margin: 0;
                color: #1c1e21;
            }

        .card-body {
            padding: 20px;
        }

        .instruction-text {
            font-size: 17px;
            margin-bottom: 20px;
            line-height: 1.4;
            color: #1c1e21;
        }

        .form-control {
            padding: 14px 16px;
            border: 1px solid #ccd0d5;
            border-radius: 6px;
            font-size: 16px;
            margin-bottom: 5px;
        }

            .form-control:focus {
                border-color: #1877f2;
                box-shadow: 0 0 0 2px #e7f3ff;
                outline: none;
            }

        .card-footer-custom {
            padding: 16px 20px;
            background-color: white;
            border-top: 1px solid #dadde1;
            text-align: right;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cancel {
            background-color: #e4e6eb;
            color: #4b4f56;
            font-weight: 600;
            padding: 0 20px;
            height: 36px;
            line-height: 36px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 15px;
            border: none;
            display: inline-block;
        }

            .btn-cancel:hover {
                background-color: #d8dadf;
                color: #4b4f56;
            }

        .btn-search {
            background-color: #1877f2;
            color: white;
            font-weight: 600;
            padding: 0 20px;
            height: 36px;
            line-height: 36px;
            border-radius: 6px;
            border: none;
            font-size: 15px;
        }

            .btn-search:hover {
                background-color: #166fe5;
            }

        .user-found-wrapper {
            display: flex;
            gap: 20px;
        }

        .user-found-info {
            flex: 1;
        }

        .user-found-avatar {
            width: 80px;
            text-align: center;
        }

            .user-found-avatar img {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid #dddfe2;
            }

        .radio-option {
            display: flex;
            align-items: center;
            margin-top: 15px;
        }

        .radio-label {
            margin-left: 10px;
            font-size: 15px;
        }
    </style>
</head>
<body>

    <div class="fb-header">
        <div class="header-content">
            <a href="/Identity/Account/Login" class="header-logo">vibee</a>
            <a href="/Identity/Account/Login" class="btn-header-login">Đăng nhập</a>
        </div>
    </div>

    <div class="content-wrapper">
        <div class="find-account-card">

            @if (!Model.IsUserFound)
            {
                <div class="card-header">
                    <h2>Tìm tài khoản của bạn</h2>
                </div>
                <form method="post">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
                        <p class="instruction-text">
                            Vui lòng nhập email hoặc số di động để tìm kiếm tài khoản của bạn.
                        </p>
                        <div class="form-group">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email hoặc số di động" />
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="card-footer-custom">
                        <a href="/Identity/Account/Login" class="btn-cancel">Hủy</a>
                        <button type="submit" class="btn-search">Tìm kiếm</button>
                    </div>
                </form>
            }
            else
            {
                <div class="card-header">
                    <h2>Đặt lại mật khẩu</h2>
                </div>
                <form method="post" asp-page-handler="SendEmail">
                    <input type="hidden" name="email" value="@Model.FoundUserEmail" />

                    <div class="card-body">
                        <div class="user-found-wrapper">
                            <div class="user-found-info">
                                <p class="instruction-text mb-2">
                                    Bạn muốn nhận mã để đặt lại mật khẩu bằng cách nào?
                                </p>
                                <div class="radio-option">
                                    <input type="radio" checked id="send-email" style="width: 18px; height: 18px;">
                                    <label for="send-email" class="radio-label">
                                        <strong>Gửi mã qua email</strong>
                                        <br>
                                        <span class="text-muted">@Model.FoundUserEmail</span>
                                    </label>
                                </div>
                            </div>

                            <div class="user-found-avatar">
                                <img src="@Model.FoundUserAvatar" alt="Avatar">
                                <div class="mt-2 small fw-bold text-truncate" style="max-width: 80px;">@Model.FoundUserName</div>
                                <div class="small text-muted">Người dùng Vibee</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer-custom">
                        <a href="./ForgotPassword" class="btn-cancel">Không phải tôi</a>
                        <button type="submit" class="btn-search">Tiếp tục</button>
                    </div>
                </form>
            }

        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>