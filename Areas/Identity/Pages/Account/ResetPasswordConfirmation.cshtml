@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thành công | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .vibee-logo {
            color: #1877f2;
            font-size: 40px;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 20px;
            text-decoration: none;
        }

        .success-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 450px;
            max-width: 90%;
            overflow: hidden;
            padding: 40px 30px;
            text-align: center;
        }

        .icon-wrapper {
            width: 80px;
            height: 80px;
            background-color: #e7f3ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 40px;
                color: #1877f2;
            }

        .card-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 15px;
            color: #1c1e21;
        }

        .card-text {
            font-size: 16px;
            color: #65676b;
            margin-bottom: 30px;
        }

        .btn-login {
            background-color: #42b72a;
            color: white;
            font-weight: 700;
            padding: 10px 30px;
            border-radius: 6px;
            border: none;
            font-size: 17px;
            text-decoration: none;
            display: inline-block;
            transition: 0.2s;
            width: 100%;
        }

            .btn-login:hover {
                background-color: #36a420;
                color: white;
            }
    </style>
</head>
<body>

    <a href="/" class="vibee-logo">vibee</a>

    <div class="success-card">
        <div class="icon-wrapper">
            <i class="bi bi-check-lg"></i>
        </div>

        <h3 class="card-title">Mật khẩu đã được đặt lại</h3>
        <p class="card-text">
            Tài khoản của bạn đã được cập nhật mật khẩu mới. Bạn có thể sử dụng mật khẩu này để đăng nhập ngay bây giờ.
        </p>

        <a href="/Identity/Account/Login" class="btn-login">Đăng nhập ngay</a>
    </div>

</body>
</html>