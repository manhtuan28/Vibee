@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --fb-bg: #f0f2f5;
            --fb-green: #42b72a;
            --fb-green-hover: #36a420;
            --fb-blue: #0866ff;
            --input-bg: #f5f6f7;
            --text-color: #1c1e21;
        }

        body {
            background-color: var(--fb-bg);
            font-family: SFProDisplay-Regular, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            color: var(--text-color);
        }

        .vibee-brand {
            font-size: 3.5rem;
            font-weight: 800;
            color: var(--fb-blue);
            margin-bottom: 20px;
            text-align: center;
            letter-spacing: -2px;
            display: block;
        }

        @@media (min-width: 992px) {
            .vibee-brand {
                display: block;
            }
        }

        .register-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 432px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .card-header {
            padding: 10px 16px;
            border-bottom: 1px solid #dadde1;
            background: white;
        }

            .card-header h2 {
                font-size: 25px;
                font-weight: 700;
                color: #1c1e21;
                margin: 0;
                line-height: 32px;
            }

            .card-header p {
                font-size: 15px;
                color: #606770;
                margin: 0;
                line-height: 24px;
            }

        .card-body {
            padding: 16px;
        }

        .form-control {
            background-color: var(--input-bg);
            border: 1px solid #ccd0d5;
            border-radius: 5px;
            padding: 11px;
            font-size: 15px;
            color: #1c1e21;
            margin-bottom: 10px;
            height: 40px;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--fb-blue);
                box-shadow: 0 0 0 2px #e7f3ff;
                outline: none;
                caret-color: var(--fb-blue);
            }

        .lbl-small {
            font-size: 12px;
            color: #606770;
            margin-bottom: 5px;
            display: block;
            font-weight: 600;
        }

        .gender-box {
            border: 1px solid #ccd0d5;
            border-radius: 4px;
            padding: 0 10px;
            height: 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: white;
            cursor: pointer;
        }

            .gender-box:hover {
                background-color: #f2f2f2;
            }

        .btn-register {
            background-color: var(--fb-green);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 18px;
            font-weight: 700;
            width: 194px;
            height: 36px;
            margin: 20px auto 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

            .btn-register:hover {
                background-color: var(--fb-green-hover);
            }

        .terms-text {
            font-size: 11px;
            color: #777;
            margin-top: 15px;
            line-height: 1.4;
            text-align: left;
        }

            .terms-text a {
                color: #385898;
                text-decoration: none;
            }

                .terms-text a:hover {
                    text-decoration: underline;
                }

        .login-link {
            text-align: center;
            margin-top: 20px;
            color: var(--fb-blue);
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            display: block;
        }

            .login-link:hover {
                text-decoration: underline;
            }

        .form-select {
            cursor: pointer;
            background-color: white;
            border: 1px solid #ccd0d5;
            height: 36px;
            padding-top: 5px;
            padding-bottom: 5px;
            font-size: 15px;
        }
    </style>
</head>
<body>

    <div class="d-flex flex-column align-items-center">
        <div class="vibee-brand">vibee</div>

        <div class="register-card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2>Tạo tài khoản mới</h2>
                        <p>Nhanh chóng và dễ dàng.</p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                    <div class="mb-2">
                        <input asp-for="Input.FullName" class="form-control" placeholder="Họ và tên" aria-required="true" />
                        <span asp-validation-for="Input.FullName" class="text-danger small" style="font-size:12px"></span>
                    </div>

                    <div class="mb-2">
                        <input asp-for="Input.Email" class="form-control" placeholder="Email" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger small" style="font-size:12px"></span>
                    </div>

                    <div class="mb-2">
                        <input asp-for="Input.Password" class="form-control" placeholder="Mật khẩu mới" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger small" style="font-size:12px"></span>
                    </div>

                    <div class="mb-2">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small" style="font-size:12px"></span>
                    </div>

                    <label class="lbl-small mt-2">Ngày sinh <i class="bi bi-question-circle-fill text-secondary"></i></label>
                    <div class="d-flex gap-2 mb-3">
                        <select id="dobDay" class="form-select" aria-label="Day">
                            @for (int i = 1; i <= 31; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <select id="dobMonth" class="form-select" aria-label="Month">
                            <option value="1">Tháng 1</option>
                            <option value="2">Tháng 2</option>
                            <option value="3">Tháng 3</option>
                            <option value="4">Tháng 4</option>
                            <option value="5">Tháng 5</option>
                            <option value="6">Tháng 6</option>
                            <option value="7">Tháng 7</option>
                            <option value="8">Tháng 8</option>
                            <option value="9">Tháng 9</option>
                            <option value="10">Tháng 10</option>
                            <option value="11">Tháng 11</option>
                            <option value="12">Tháng 12</option>
                        </select>
                        <select id="dobYear" class="form-select" aria-label="Year">
                            @for (int i = DateTime.Now.Year; i >= 1905; i--)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="lbl-small mb-1 fw-bold text-muted" style="font-size: 0.8rem;">
                            Giới tính <i class="bi bi-question-circle-fill text-secondary" title="Sau này bạn có thể tùy chỉnh ai sẽ thấy giới tính của mình."></i>
                        </label>

                        <div class="d-flex gap-3">
                            <label class="gender-box flex-fill border rounded p-2 d-flex align-items-center justify-content-between cursor-pointer" for="gender_female">
                                <span class="small fw-bold">Nữ</span>
                                <input class="form-check-input m-0" type="radio" asp-for="Input.Gender" id="gender_female" value="Nữ">
                            </label>

                            <label class="gender-box flex-fill border rounded p-2 d-flex align-items-center justify-content-between cursor-pointer" for="gender_male">
                                <span class="small fw-bold">Nam</span>
                                <input class="form-check-input m-0" type="radio" asp-for="Input.Gender" id="gender_male" value="Nam" checked>
                            </label>

                            <label class="gender-box flex-fill border rounded p-2 d-flex align-items-center justify-content-between cursor-pointer" for="gender_custom">
                                <span class="small fw-bold">Tùy chỉnh</span>
                                <input class="form-check-input m-0" type="radio" asp-for="Input.Gender" id="gender_custom" value="Khác">
                            </label>
                        </div>

                        <span asp-validation-for="Input.Gender" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <p class="terms-text">
                        Những người dùng dịch vụ của chúng tôi có thể đã tải thông tin liên hệ của bạn lên Vibee. <a href="#">Tìm hiểu thêm</a>.
                        <br><br>
                        Bằng cách nhấp vào Đăng ký, bạn đồng ý với <a href="#">Điều khoản</a>, <a href="#">Chính sách quyền riêng tư</a> và <a href="#">Chính sách cookie</a> của chúng tôi.
                    </p>

                    <div class="text-center">
                        <button id="registerSubmit" type="submit" class="btn-register">Đăng ký</button>
                    </div>

                    <div class="text-center">
                        <a href="/Identity/Account/Login" class="login-link">Bạn đã có tài khoản ư?</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const daySelect = document.getElementById('dobDay');
        const monthSelect = document.getElementById('dobMonth');
        const yearSelect = document.getElementById('dobYear');

        function updateDays() {
            const month = parseInt(monthSelect.value);
            const year = parseInt(yearSelect.value);
            const currentDay = parseInt(daySelect.value);
            const daysInMonth = new Date(year, month, 0).getDate();

            daySelect.innerHTML = '';

            for (let i = 1; i <= daysInMonth; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.text = i;
                if (i === currentDay || (i === daysInMonth && currentDay > daysInMonth)) {
                    option.selected = true;
                }
                daySelect.appendChild(option);
            }
        }

        monthSelect.addEventListener('change', updateDays);
        yearSelect.addEventListener('change', updateDays);
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>