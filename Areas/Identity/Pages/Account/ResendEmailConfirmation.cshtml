@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Gửi lại email kích hoạt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kích hoạt tài khoản | Vibee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f0f2f5;
            font-family: Helvetica, Arial, sans-serif;
            color: #1c1e21;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .vibee-logo {
            color: #1877f2;
            font-size: 40px;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 20px;
            text-decoration: none;
        }

        .resend-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1), 0 8px 16px rgba(0, 0, 0, .1);
            width: 450px;
            max-width: 90%;
            overflow: hidden;
            padding: 30px;
            text-align: center;
        }

        .icon-wrapper {
            width: 70px;
            height: 70px;
            background-color: #e7f3ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

            .icon-wrapper i {
                font-size: 35px;
                color: #1877f2;
            }

        .card-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #1c1e21;
        }

        .card-subtitle {
            font-size: 15px;
            color: #65676b;
            margin-bottom: 25px;
            line-height: 1.4;
        }

        .form-control {
            padding: 12px 16px;
            border-radius: 6px;
            border: 1px solid #ccd0d5;
            font-size: 16px;
            margin-bottom: 5px;
        }

            .form-control:focus {
                border-color: #1877f2;
                box-shadow: 0 0 0 2px #e7f3ff;
                outline: none;
            }

        .btn-resend {
            background-color: #1877f2;
            color: white;
            font-weight: 700;
            padding: 10px 0;
            width: 100%;
            border-radius: 6px;
            border: none;
            font-size: 17px;
            transition: 0.2s;
            margin-top: 15px;
        }

            .btn-resend:hover {
                background-color: #166fe5;
                color: white;
            }

        .back-link {
            margin-top: 20px;
            display: block;
            color: #1877f2;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <a href="/" class="vibee-logo">vibee</a>

    <div class="resend-card">
        <div class="icon-wrapper">
            <i class="bi bi-envelope-paper-heart-fill"></i>
        </div>

        <h3 class="card-title">Gửi lại email kích hoạt</h3>
        <p class="card-subtitle">
            Nhập email của bạn để nhận lại liên kết kích hoạt tài khoản mới.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-success small mb-3 fw-bold" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="Nhập email của bạn" />
                <label asp-for="Input.Email" class="text-secondary">Email đăng ký</label>
                <span asp-validation-for="Input.Email" class="text-danger small text-start d-block"></span>
            </div>

            <button type="submit" class="btn-resend">Gửi lại</button>
        </form>

        <a href="/Identity/Account/Login" class="back-link">Quay lại đăng nhập</a>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>